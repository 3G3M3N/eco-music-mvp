rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // MEVCUT PROJE KURALLARI (KORUNDU)
    // =========================================================================
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /predictions/{predictionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    match /leagues/{leagueId} {
      allow read, write: if request.auth != null;
      match /chat/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
    
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }

    match /friend_requests/{requestId} {
      allow read: if request.auth != null && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.fromId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }

    match /direct_chats/{chatId} {
      allow read: if request.auth != null && (resource != null && request.auth.uid in resource.data.memberIds);
      allow create: if request.auth != null && (request.resource.data != null && request.auth.uid in request.resource.data.memberIds);
      allow update: if request.auth != null && (
        (resource != null && request.auth.uid in resource.data.memberIds) || 
        (request.resource.data != null && request.auth.uid in request.resource.data.memberIds)
      );
      allow delete: if request.auth != null && (resource != null && request.auth.uid in resource.data.memberIds);
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // =========================================================================
    // ECO MUSIC & VIDEO COLLAB PLATFORM KOLEKSİYONLARI (ORTAK CANLI VERİTABANI)
    // =========================================================================
    match /eco_users/{docId} {
      allow read, write: if true;
    }
    match /eco_tracks/{docId} {
      allow read, write: if true;
    }
    match /eco_comments/{docId} {
      allow read, write: if true;
    }
    match /eco_follows/{docId} {
      allow read, write: if true;
    }
    match /eco_messages/{docId} {
      allow read, write: if true;
    }
    match /eco_reports/{docId} {
      allow read, write: if true;
    }
    match /eco_blocks/{docId} {
      allow read, write: if true;
    }
  }
}
